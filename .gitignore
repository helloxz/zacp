# Binaries
backend/bin/
backend/server
*.exe
*.dll
*.so
*.dylib

# Go
backend/vendor/

# Runtime config/db live under ~/.zacp (not in repo).
# Keep ignoring accidental local copies under backend/configs/
backend/configs/config.toml
backend/configs/config.yaml
backend/data/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Node / frontend (when scaffolded; package manager is Bun)
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/out/
frontend/coverage/
# Prefer bun.lock only — ignore other package managers' locks if created by mistake
frontend/package-lock.json
frontend/pnpm-lock.yaml
frontend/yarn.lock
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build / temp
tmp/
temp/
*.tmp
coverage.out
coverage.html

# Runtime home accidentally committed in repo root (AGENTS.md: runtime state lives in $ZACP_HOME, default ~/.zacp)
.zacp/
